# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Replace with your local or Atlas MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database_name>?retryWrites=true&w=majority

# Session Security Secret
SESSION_SECRET=your_long_random_session_secret_key_here

# Initial Admin Seed Credentials (for dev seed script: scripts/seedAdmin.js)
SEED_ADMIN_ID=0001
SEED_ADMIN_PASSWORD=your_initial_admin_password_here
